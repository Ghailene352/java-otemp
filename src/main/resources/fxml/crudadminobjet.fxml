<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="950.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="otemps.controllers.ObjetFormController">
    <left>
        <VBox prefWidth="280.0" spacing="20.0" style="-fx-background-color: #2c3e50; -fx-padding: 30;">
            <children>
                <Label text="🏛️ OTEMPS" textFill="#c5a059">
                    <font><Font name="System Bold" size="28.0" /></font>
                </Label>
                <Label text="Gestion du Patrimoine" textFill="WHITE">
                    <font><Font size="14.0" /></font>
                </Label>
                <Separator opacity="0.3" />
                <Label text="Interface d'ajout de nouvelles pièces à la collection royale." textFill="#bdc3c7" wrapText="true" />
            </children>
        </VBox>
    </left>
    <center>
        <VBox spacing="25.0" style="-fx-padding: 40;">
            <children>
                <Label fx:id="lblTitre" text="Ajouter un Nouvel Objet" textFill="#2c3e50">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Label>
                <Separator />

                <GridPane hgap="20.0" vgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="160.0" prefWidth="160.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="40.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="40.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="40.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="40.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="40.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="120.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Nom de l'objet * :" GridPane.rowIndex="0" style="-fx-font-weight: bold;" />
                        <TextField fx:id="tfNom" prefHeight="35.0" promptText="Ex: Masque Funéraire" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="Catégorie * :" GridPane.rowIndex="1" style="-fx-font-weight: bold;" />
                        <ComboBox fx:id="cbCategorie" maxWidth="Infinity" prefHeight="35.0" promptText="Sélectionner la catégorie" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Époque :" GridPane.rowIndex="2" />
                        <TextField fx:id="tfEpoque" prefHeight="35.0" promptText="Ex: XVIIIème dynastie" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="Origine :" GridPane.rowIndex="3" />
                        <TextField fx:id="tfOrigine" prefHeight="35.0" promptText="Ex: Louxor, Égypte" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label text="Matériaux :" GridPane.rowIndex="4" />
                        <TextField fx:id="tfMateriaux" prefHeight="35.0" promptText="Ex: Or massif, Quartz" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                        <Label text="Description :" GridPane.rowIndex="5" />
                        <TextArea fx:id="taDescription" prefHeight="100.0" promptText="Détails historiques de l'objet..." wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                    </children>
                </GridPane>

                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <children>
                        <Label fx:id="lblMessage" prefHeight="17.0" prefWidth="282.0" />
                        <Button onAction="#handleAnnuler" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #ecf0f1; -fx-cursor: hand;" text="Réinitialiser" />
                        <Button fx:id="btnEnregistrer" onAction="#handleEnregistrer" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="💾 Enregistrer l'objet" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>