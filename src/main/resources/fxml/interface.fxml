<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="700.0" minWidth="1200.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="otemps.controllers.ShowController">

    <style>
        .root {
        -fx-font-family: "Playfair Display";
        }

        .btn-custom {
        -fx-background-color: #c5a059;
        -fx-text-fill: white;
        -fx-padding: 10 20;
        -fx-font-size: 12;
        -fx-border-radius: 4;
        -fx-cursor: hand;
        }

        .btn-custom:hover {
        -fx-background-color: #b8963f;
        }
    </style>

    <!-- EN-TÊTE -->
    <top>
        <HBox spacing="10" style="-fx-background-color: #2c2c2c; -fx-padding: 15;">
            <Button fx:id="btnBack" text="← Retour" onAction="#handleBack"
                    styleClass="btn-custom" />
            <Label fx:id="titleLabel" text="Titre de l'objet"
                   style="-fx-font-size: 20; -fx-text-fill: #c5a059; -fx-font-weight: bold;"
                   HBox.hgrow="ALWAYS" />
            <Button fx:id="btnPrint" text="📄 Imprimer" onAction="#handlePrint"
                    styleClass="btn-custom" />
            <Button fx:id="btnPDF" text="⬇️ PDF" onAction="#handleExportPDF"
                    styleClass="btn-custom" />
        </HBox>
    </top>

    <!-- CONTENU PRINCIPAL -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f8f9fa;">
            <VBox spacing="30" style="-fx-padding: 30; -fx-background-color: #f8f9fa;">

                <!-- TITRE CENTRÉ -->
                <VBox alignment="CENTER" spacing="10">
                    <Label fx:id="mainTitleLabel" text="Titre"
                           style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #2c2c2c;" />
                    <Label text="Patrimoine culturel - OTEMPS"
                           style="-fx-font-size: 12; -fx-text-fill: #999; -fx-font-style: italic;" />
                </VBox>

                <!-- IMAGE PRINCIPALE -->
                <VBox alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 8;">
                    <ImageView fx:id="mainImageView" fitHeight="400.0" fitWidth="700.0"
                               preserveRatio="true"
                               style="-fx-border-color: white; -fx-border-width: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 5);" />
                </VBox>

                <!-- INFORMATIONS -->
                <VBox spacing="15" style="-fx-background-color: #fdfbfb; -fx-padding: 20; -fx-border-radius: 8; -fx-border-left: 5 solid #c5a059; -fx-border-color: #efefef;">
                    <Label text="Informations"
                           style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2c2c2c;" />

                    <HBox spacing="30" style="-fx-wrap-text: true;">
                        <VBox spacing="8">
                            <Label text="CATÉGORIE"
                                   style="-fx-font-weight: bold; -fx-text-fill: #c5a059; -fx-font-size: 10;" />
                            <Label fx:id="categorieLabel" text="Non spécifiée"
                                   style="-fx-font-size: 14;" />
                        </VBox>
                        <VBox spacing="8">
                            <Label text="ÉPOQUE"
                                   style="-fx-font-weight: bold; -fx-text-fill: #c5a059; -fx-font-size: 10;" />
                            <Label fx:id="epoqueLabel" text="Non spécifiée"
                                   style="-fx-font-size: 14;" />
                        </VBox>
                        <VBox spacing="8">
                            <Label text="ORIGINE"
                                   style="-fx-font-weight: bold; -fx-text-fill: #c5a059; -fx-font-size: 10;" />
                            <Label fx:id="origineLabel" text="Non spécifiée"
                                   style="-fx-font-size: 14;" />
                        </VBox>
                        <VBox spacing="8">
                            <Label text="MATÉRIAUX"
                                   style="-fx-font-weight: bold; -fx-text-fill: #c5a059; -fx-font-size: 10;" />
                            <Label fx:id="materiauxLabel" text="Non spécifiés"
                                   style="-fx-font-size: 14;" wrapText="true" />
                        </VBox>
                    </HBox>
                </VBox>

                <!-- DESCRIPTION -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 8; -fx-border-color: #efefef;">
                    <Label text="📖 Description"
                           style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #c5a059; -fx-border-bottom: 2 solid #c5a059; -fx-padding: 0 0 10 0;" />
                    <Label fx:id="descriptionLabel" text="Aucune description"
                           wrapText="true" style="-fx-font-size: 13; -fx-text-fill: #555; -fx-line-spacing: 1.5;" />
                </VBox>

                <!-- GALERIE DE MÉDIAS -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 8; -fx-border-color: #efefef;">
                    <Label text="🖼️ Galerie"
                           style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #c5a059; -fx-border-bottom: 2 solid #c5a059; -fx-padding: 0 0 10 0;" />
                    <HBox fx:id="mediasContainer" spacing="15" style="-fx-wrap-text: true; -fx-padding: 10;" />
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <!-- PIED DE PAGE -->
    <bottom>
        <HBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-border-top: 1 solid #efefef;">
            <Button fx:id="btnBackBottom" text="← Retour à la galerie" onAction="#handleBack"
                    styleClass="btn-custom" />
            <Button fx:id="btnPrintBottom" text="📄 Imprimer / PDF" onAction="#handlePrint"
                    styleClass="btn-custom" />
        </HBox>
    </bottom>
</BorderPane>