<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="otemps.controllers.MediaController">

    <style>
        .admin-header {
        -fx-background-color: #2c2c2c;
        -fx-padding: 20;
        -fx-spacing: 10;
        }

        .admin-title {
        -fx-font-size: 24;
        -fx-font-weight: bold;
        -fx-text-fill: #c5a059;
        }

        .btn-primary {
        -fx-background-color: #c5a059;
        -fx-text-fill: white;
        -fx-padding: 8 15;
        -fx-cursor: hand;
        }

        .btn-primary:hover {
        -fx-background-color: #b8963f;
        }

        .btn-danger {
        -fx-background-color: #e74c3c;
        -fx-text-fill: white;
        -fx-padding: 5 10;
        -fx-cursor: hand;
        }

        .btn-danger:hover {
        -fx-background-color: #c0392b;
        }
    </style>

    <!-- EN-TÊTE -->
    <top>
        <VBox styleClass="admin-header">
            <HBox spacing="10" style="-fx-alignment: center-left;">
                <Label text="🖼️ Gestion des Médias" styleClass="admin-title" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnUpload" text="⬆️ Télécharger" onAction="#handleUpload"
                        styleClass="btn-primary" />
            </HBox>

            <!-- Filtres -->
            <HBox spacing="10" style="-fx-padding: 15 0 0 0;">
                <ComboBox fx:id="cbObjet" promptText="Filtrer par objet" prefWidth="300" HBox.hgrow="ALWAYS" />
                <Button text="🔍 Filtrer" onAction="#handleFiltrer" styleClass="btn-primary" />
            </HBox>
        </VBox>
    </top>

    <!-- TABLEAU -->
    <center>
        <TableView fx:id="tableMedias" style="-fx-font-size: 11;">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50" />
                <TableColumn fx:id="colObjet" text="Objet" prefWidth="250" />
                <TableColumn fx:id="colType" text="Type" prefWidth="100" />
                <TableColumn fx:id="colFichier" text="Fichier" prefWidth="350" />
                <TableColumn fx:id="colActions" text="Actions" prefWidth="100" />
            </columns>
        </TableView>
    </center>

    <!-- PIED DE PAGE -->
    <bottom>
        <HBox style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-alignment: center-right;">
            <Label fx:id="lblTotal" text="Total: 0 médias" style="-fx-text-fill: #666;" HBox.hgrow="ALWAYS" />
            <Button text="Retour" onAction="#handleRetour" styleClass="btn-primary" />
        </HBox>
    </bottom>
</BorderPane>