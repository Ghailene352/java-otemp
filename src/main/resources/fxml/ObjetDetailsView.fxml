<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="900.0" minWidth="1600.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="otemps.controllers.ObjetDetailsController"
            style="-fx-background-color: #1a1a1a;">

    <top>
        <VBox style="-fx-background-color: #0d0d0d; -fx-border-color: #d4af37; -fx-border-width: 0 0 3 0;">
            <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 20; -fx-background-color: #0d0d0d;">
                <Button fx:id="btnBack" text="← Retour" onAction="#handleBack"
                        style="-fx-background-color: #d4af37; -fx-text-fill: #0d0d0d; -fx-padding: 10 25; -fx-font-weight: bold; -fx-font-size: 12; -fx-cursor: hand; -fx-background-radius: 5;" />

                <Label fx:id="titleLabel" text="📜 Détails de l'Objet"
                       style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #d4af37;" />

                <Region HBox.hgrow="ALWAYS" />

                <ComboBox fx:id="languageSelector" onAction="#onLanguageChange" promptText="🌐 Langue..."
                          style="-fx-background-color: #2c2c2c; -fx-text-fill: #d4af37; -fx-padding: 8 15; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" />

                <Button fx:id="btnPrint" text="📄 Imprimer" onAction="#handlePrint"
                        style="-fx-background-color: #c5a059; -fx-text-fill: white; -fx-padding: 8 15; -fx-font-weight: bold; -fx-font-size: 11; -fx-cursor: hand; -fx-background-radius: 5;" />

                <Button fx:id="btnPDF" text="⬇️ PDF" onAction="#handleExportPDF"
                        style="-fx-background-color: #ff6b6b; -fx-text-fill: white; -fx-padding: 8 15; -fx-font-weight: bold; -fx-font-size: 11; -fx-cursor: hand; -fx-background-radius: 5;" />
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #1a1a1a; -fx-control-inner-background: #1a1a1a;">
            <VBox spacing="40" alignment="TOP_CENTER" style="-fx-padding: 50; -fx-background-color: #1a1a1a;">

                <!-- TITRE PRINCIPAL -->
                <VBox alignment="CENTER" spacing="10">
                    <Label fx:id="mainTitleLabel" text="NOM DE L'OBJET"
                           style="-fx-font-size: 48; -fx-font-weight: bold; -fx-text-fill: #d4af37; -fx-padding: 0;" />
                    <Label text="🏛️ PIÈCE DE COLLECTION OTEMPS"
                           style="-fx-font-size: 16; -fx-text-fill: #999; -fx-font-style: italic; -fx-padding: 0;" />
                </VBox>

                <!-- IMAGE PRINCIPALE + VUE 3D -->
                <VBox alignment="CENTER" spacing="20">
                    <StackPane fx:id="displayStack"
                               style="-fx-background-color: #0d0d0d; -fx-border-color: #d4af37; -fx-border-width: 3; -fx-border-radius: 10;"
                               minHeight="500.0" minWidth="900.0" maxWidth="900.0">
                        <ImageView fx:id="mainImageView" fitHeight="500.0" fitWidth="900.0" preserveRatio="false" />
                        <Pane fx:id="pane3D" visible="false" managed="false" prefHeight="500.0" prefWidth="900.0" />
                    </StackPane>
                    <Button fx:id="btnToggle3D" text="📦 VOIR CET OBJET EN 3D" onAction="#handleToggle3D"
                            style="-fx-background-color: #ff6b6b; -fx-text-fill: white; -fx-padding: 15 50; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 30; -fx-cursor: hand;" />
                </VBox>

                <!-- CARACTÉRISTIQUES -->
                <VBox spacing="25" style="-fx-background-color: #0d0d0d; -fx-padding: 30; -fx-background-radius: 10; -fx-border-color: #d4af37; -fx-border-width: 2;">
                    <Label text="⚙️ CARACTÉRISTIQUES TECHNIQUES"
                           style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #d4af37;" />
                    <Separator style="-fx-text-fill: #d4af37;" />
                    <HBox spacing="60" alignment="CENTER">
                        <VBox alignment="CENTER" spacing="10">
                            <Label text="📚 CATÉGORIE"
                                   style="-fx-font-weight: bold; -fx-text-fill: #d4af37; -fx-font-size: 12;" />
                            <Label fx:id="categorieLabel" text="-"
                                   style="-fx-font-size: 16; -fx-text-fill: #d4af37; -fx-font-weight: bold;" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="10">
                            <Label text="📅 ÉPOQUE"
                                   style="-fx-font-weight: bold; -fx-text-fill: #d4af37; -fx-font-size: 12;" />
                            <Label fx:id="epoqueLabel" text="-"
                                   style="-fx-font-size: 16; -fx-text-fill: #999; -fx-font-weight: bold;" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="10">
                            <Label text="🌍 ORIGINE"
                                   style="-fx-font-weight: bold; -fx-text-fill: #d4af37; -fx-font-size: 12;" />
                            <Label fx:id="origineLabel" text="-"
                                   style="-fx-font-size: 16; -fx-text-fill: #999; -fx-font-weight: bold;" />
                        </VBox>
                        <VBox alignment="CENTER" spacing="10">
                            <Label text="🔨 MATÉRIAUX"
                                   style="-fx-font-weight: bold; -fx-text-fill: #d4af37; -fx-font-size: 12;" />
                            <Label fx:id="materiauxLabel" text="-"
                                   style="-fx-font-size: 16; -fx-text-fill: #999; -fx-font-weight: bold;" />
                        </VBox>
                    </HBox>
                </VBox>

                <!-- DESCRIPTION (AVEC TRADUCTION) -->
                <VBox spacing="20" style="-fx-background-color: #0d0d0d; -fx-padding: 30; -fx-background-radius: 10; -fx-border-color: #d4af37; -fx-border-width: 2;">
                    <Label text="📖 HISTOIRE &amp; RÉCIT"
                           style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #d4af37;" />
                    <Separator style="-fx-text-fill: #d4af37;" />
                    <Label fx:id="descriptionLabel" text="Chargement de la description..."
                           style="-fx-font-size: 14; -fx-text-fill: #bbb; -fx-wrap-text: true; -fx-line-spacing: 1.8;" />
                    <Label fx:id="traductionStatus" text=""
                           style="-fx-font-size: 12; -fx-text-fill: #999; -fx-font-style: italic;" />
                </VBox>

                <!-- GALERIE -->
                <VBox spacing="20" style="-fx-background-color: #0d0d0d; -fx-padding: 30; -fx-background-radius: 10; -fx-border-color: #d4af37; -fx-border-width: 2;">
                    <Label text="🖼️ GALERIE PHOTOS"
                           style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #d4af37;" />
                    <Separator style="-fx-text-fill: #d4af37;" />
                    <HBox fx:id="mediasContainer" spacing="30" alignment="CENTER"
                          style="-fx-padding: 20; -fx-background-color: #1a1a1a; -fx-border-radius: 8;" />
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER"
              style="-fx-background-color: #0d0d0d; -fx-border-color: #d4af37; -fx-border-width: 3 0 0 0; -fx-padding: 20;">
            <Label text="© 2026 OTEMPS MUSEUM - Système de Présentation du Patrimoine Historique"
                   style="-fx-text-fill: #d4af37; -fx-font-weight: bold; -fx-font-size: 11;" />
        </HBox>
    </bottom>
</BorderPane>