<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="500.0" minWidth="800.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="otemps.controllers.CategorieFormController">

    <style>
        .form-title {
        -fx-font-size: 20;
        -fx-font-weight: bold;
        -fx-text-fill: #2c2c2c;
        -fx-padding: 0 0 20 0;
        }

        .form-label {
        -fx-font-weight: bold;
        -fx-text-fill: #2c2c2c;
        -fx-font-size: 12;
        }

        .form-field {
        -fx-padding: 8;
        -fx-border-radius: 4;
        -fx-font-size: 11;
        }

        .btn-success {
        -fx-background-color: #27ae60;
        -fx-text-fill: white;
        -fx-padding: 10 25;
        -fx-font-size: 12;
        -fx-cursor: hand;
        }

        .btn-success:hover {
        -fx-background-color: #229954;
        }

        .btn-cancel {
        -fx-background-color: #95a5a6;
        -fx-text-fill: white;
        -fx-padding: 10 25;
        -fx-font-size: 12;
        -fx-cursor: hand;
        }

        .btn-cancel:hover {
        -fx-background-color: #7f8c8d;
        }
    </style>

    <!-- FORMULAIRE -->
    <center>
        <VBox spacing="20" style="-fx-padding: 30;">

            <Label fx:id="lblTitre" text="Ajouter une Catégorie" styleClass="form-title" />

            <!-- NOM -->
            <VBox spacing="5">
                <Label text="Nom de la catégorie *" styleClass="form-label" />
                <TextField fx:id="tfNom" styleClass="form-field" promptText="Ex: Sculpture" />
            </VBox>

            <!-- DESCRIPTION -->
            <VBox spacing="5">
                <Label text="Description" styleClass="form-label" />
                <TextArea fx:id="taDescription" styleClass="form-field"
                          promptText="Décrivez la catégorie..." wrapText="true"
                          prefRowCount="6" />
            </VBox>

            <!-- BOUTONS -->
            <HBox spacing="10" style="-fx-padding: 20 0 0 0;">
                <Button fx:id="btnEnregistrer" text="✓ Enregistrer" onAction="#handleEnregistrer"
                        styleClass="btn-success" />
                <Button text="✕ Annuler" onAction="#handleAnnuler"
                        styleClass="btn-cancel" />
            </HBox>

            <Label fx:id="lblMessage" text="" style="-fx-text-fill: #27ae60; -fx-padding: 10 0 0 0;" />

        </VBox>
    </center>
</BorderPane>