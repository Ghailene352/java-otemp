<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="800.0" minWidth="1200.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="otemps.controllers.HomeController">

    <style>
        .root {
        -fx-font-family: "Segoe UI", "Arial";
        -fx-background-color: #f8f9fa;
        }

        .header {
        -fx-background-color: #2c2c2c;
        -fx-text-fill: #ffffff;
        -fx-padding: 20;
        }

        .title {
        -fx-font-size: 28;
        -fx-font-weight: bold;
        -fx-text-fill: #c5a059;
        }

        .subtitle {
        -fx-font-size: 12;
        -fx-text-fill: #999999;
        -fx-padding: 5 0 0 0;
        }

        .search-box {
        -fx-padding: 15 0 0 0;
        -fx-spacing: 10;
        }

        .search-field {
        -fx-font-size: 12;
        -fx-padding: 8;
        -fx-border-radius: 4;
        }

        .btn-search {
        -fx-background-color: #c5a059;
        -fx-text-fill: white;
        -fx-padding: 8 20;
        -fx-font-size: 12;
        -fx-border-radius: 4;
        -fx-cursor: hand;
        }

        .btn-search:hover {
        -fx-background-color: #b8963f;
        }

        .objet-card {
        -fx-border-color: #ddd;
        -fx-border-radius: 8;
        -fx-padding: 15;
        -fx-background-color: white;
        -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);
        }

        .objet-title {
        -fx-font-size: 14;
        -fx-font-weight: bold;
        -fx-text-fill: #2c2c2c;
        -fx-padding: 10 0 5 0;
        }

        .objet-category {
        -fx-font-size: 11;
        -fx-text-fill: #c5a059;
        }

        .btn-view {
        -fx-background-color: #c5a059;
        -fx-text-fill: white;
        -fx-padding: 8 15;
        -fx-font-size: 11;
        -fx-border-radius: 3;
        -fx-cursor: hand;
        }

        .btn-view:hover {
        -fx-background-color: #b8963f;
        }
    </style>

    <!-- EN-TÊTE -->
    <top>
        <VBox styleClass="header">
            <Label text="🏛️ OTEMPS - Galerie Royale" styleClass="title" />
            <Label text="Patrimoine culturel" styleClass="subtitle" />

            <!-- Barre de recherche -->
            <HBox styleClass="search-box">
                <TextField fx:id="searchField" promptText="Rechercher par nom, époque, origine..."
                           styleClass="search-field" HBox.hgrow="ALWAYS" />
                <Button fx:id="searchButton" text="🔍 Rechercher" onAction="#handleDynamicSearch"
                        styleClass="btn-search" />
                <Button fx:id="resetButton" text="↻ Réinitialiser" onAction="#handleReset"
                        styleClass="btn-search" />
            </HBox>
        </VBox>
    </top>

    <!-- GALERIE -->
    <center>
        <ScrollPane fitToWidth="true">
            <FlowPane fx:id="galerieContainer"
                      style="-fx-padding: 20; -fx-background-color: #f8f9fa;" />
        </ScrollPane>
    </center>

    <!-- PIED DE PAGE -->
    <bottom>
        <HBox style="-fx-background-color: #2c2c2c; -fx-padding: 20; -fx-alignment: center;">
            <Label text="© OTEMPS - Patrimoine Culturel | Tous droits réservés"
                   style="-fx-text-fill: #999;" />
        </HBox>
    </bottom>
</BorderPane>