<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1180.0" styleClass="main-pane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.guser.controller.DashboardController">
    <left>
        <VBox prefWidth="250.0" spacing="16.0" styleClass="sidebar">
            <padding>
                <Insets bottom="28.0" left="20.0" right="20.0" top="28.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="brand-lockup">
                    <children>
                        <StackPane styleClass="brand-logo-shell">
                            <children>
                                <ImageView fitHeight="44.0" fitWidth="44.0" preserveRatio="true" smooth="true">
                                    <image>
                                        <Image url="@assets/logo-otemps.png" />
                                    </image>
                                </ImageView>
                            </children>
                        </StackPane>
                        <VBox spacing="2.0">
                            <children>
                                <Label styleClass="brand-title" text="&#212;Temps" />
                                <Label styleClass="brand-subtitle" text="Tableau de bord" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <Button mnemonicParsing="false" styleClass="nav-button,active" text="Dashboard" />
                <Button mnemonicParsing="false" onAction="#ouvrirUtilisateurs" styleClass="nav-button" text="Utilisateurs" />
                <Button mnemonicParsing="false" onAction="#deconnexion" styleClass="nav-button" text="Deconnexion" />
            </children>
        </VBox>
    </left>
    <center>
        <VBox spacing="24.0">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="12.0" styleClass="top-bar">
                    <padding>
                        <Insets bottom="16.0" left="28.0" right="28.0" top="16.0" />
                    </padding>
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Label styleClass="page-title" text="Dashboard administrateur" />
                                <Label fx:id="welcomeLabel" styleClass="event-card-subtitle" text="Bienvenue" />
                                <Label fx:id="roleLabel" styleClass="event-card-subtitle" text="Role : ADMIN" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <HBox spacing="20.0">
                    <padding>
                        <Insets left="28.0" right="28.0" />
                    </padding>
                    <children>
                        <VBox prefWidth="250.0" spacing="10.0" styleClass="event-card">
                            <children>
                                <Label styleClass="event-card-subtitle" text="Total utilisateurs" />
                                <Label fx:id="totalUsersLabel" styleClass="metric-value" text="0" />
                            </children>
                        </VBox>
                        <VBox prefWidth="250.0" spacing="10.0" styleClass="event-card">
                            <children>
                                <Label styleClass="event-card-subtitle" text="Emails verifies" />
                                <Label fx:id="verifiedUsersLabel" styleClass="metric-value" text="0" />
                            </children>
                        </VBox>
                        <VBox prefWidth="250.0" spacing="10.0" styleClass="event-card">
                            <children>
                                <Label styleClass="event-card-subtitle" text="Ajouts aujourd'hui" />
                                <Label fx:id="todayUsersLabel" styleClass="metric-value" text="0" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <VBox spacing="16.0" styleClass="event-card">
                    <padding>
                        <Insets left="28.0" right="28.0" />
                    </padding>
                    <children>
                        <Label styleClass="event-card-title" text="Acces rapide" />
                        <Label styleClass="event-card-subtitle" text="Seuls les utilisateurs ayant le role ADMIN peuvent acceder ici. Depuis ce dashboard vous ouvrez la gestion professionnelle des utilisateurs." wrapText="true" />
                        <HBox spacing="12.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#ouvrirUtilisateurs" styleClass="btn-primary" text="Gerer les utilisateurs" />
                                <Region />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>

